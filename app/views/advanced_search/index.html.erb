<div id="advanced-search-container" class="container mt-6">
  <%= render 'form', entity_type: @entity_type, filters: @filters %>

  <% if @searched %>
    <% if @results.present? %>
      <% result_rows = @results.map { |result| AdvancedSearchController::SearchResultRow.new(result.class.name, result.id, result.name) } %>
      <%= render(SearchResults.new(results: result_rows)) %>
      <%= render(Common::PageNav.new(collection: @results, path: '/search/advanced', extra_params: { entity_type: @entity_type, filters: @filters })) %>
    <% else %>
      <p class="mt-3">No results found.</p>
    <% end %>
  <% end %>
</div>
