<%
  filters = local_assigns[:filters] || []
  first_filter = filters[0] || {}
  second_filter = filters[1] || {}
  second_filter_values = Array(second_filter[:facet_value_id])
%>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h5 mb-1">Advanced search</h2>
    <p class="grey mb-3">Find people or groups by the categories they belong to.</p>

    <%= form_with url: advanced_search_path, method: :get, html: { class: 'advanced-search-form' } do %>
      <div class="row g-2 align-items-center mb-3">
        <%= label_tag :entity_type, 'Find', class: 'fw-semibold col-auto mb-0' %>
        <div class="col-auto">
          <%= select_tag :entity_type, options_for_select([['People', 'Person'], ['Groups', 'Group']], entity_type), class: 'form-select form-select-sm' %>
        </div>
        <div class="col-auto">who belong to&hellip;</div>
      </div>

      <div class="row g-2 align-items-center mb-3">
        <%= hidden_field_tag 'filters[][facet_type]', 'Category' %>
        <div class="col-auto">
          <%= render 'category_select', field_name: 'filters[][facet_value_id]', field_id: 'filter_row1_category',
                                         selected_id: first_filter[:facet_value_id] %>
        </div>
      </div>

      <div class="row g-2 align-items-center mb-3">
        <%# facet_type must come first here: Rack groups a repeated array-of-hashes key
            (filters[][...]) into a new hash as soon as it sees that key again, so this
            hidden field has to open row 2's hash before joiner/facet_value_id populate it. %>
        <%= hidden_field_tag 'filters[][facet_type]', 'Category' %>
        <div class="col-auto">
          <%= label_tag 'filters__joiner', 'Combine with', class: 'visually-hidden' %>
          <%= select_tag 'filters[][joiner]', options_for_select([['AND', 'AND'], ['OR', 'OR']], second_filter[:joiner]), class: 'form-select form-select-sm' %>
        </div>

        <%# Bordered as one unit so it reads as "row 1 AND (this OR-group)", not four
            disconnected dropdowns - the two selects below are OR'd with each other. %>
        <div class="col-auto d-flex align-items-center gap-2 border rounded p-2 bg-light">
          <%= render 'category_select', field_name: 'filters[][facet_value_id][]', field_id: 'filter_row2_category_a',
                                         label_text: 'First category', selected_id: second_filter_values[0] %>
          <span class="fw-semibold">OR</span>
          <%= render 'category_select', field_name: 'filters[][facet_value_id][]', field_id: 'filter_row2_category_b',
                                         label_text: 'Second category', selected_id: second_filter_values[1] %>
        </div>
      </div>

      <%= submit_tag 'Search', class: 'btn btn-primary btn-sm' %>
    <% end %>
  </div>
</div>
