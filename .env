PORT=3000
# DEV_DATABASE_NAME=lester_add_councils_i_development
# TEST_DATABASE_NAME=lester_add_councils_i_test

# config/vite.json hardcodes port 3036, which collides across worktrees.
# vite_ruby reads VITE_RUBY_<OPTION> env vars as overrides (see vite_ruby/config.rb),
# so each worktree needs its own value here - matched to PORT above for easy pairing.
VITE_RUBY_PORT=3137